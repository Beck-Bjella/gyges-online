+/// Portable software PEXT, for targets without BMI2 (wasm32 in particular).
+///
+/// Gathers the bits of `val` selected by `mask` into the low bits of the result,
+/// in ascending bit order — bit-for-bit identical to `_pext_u64`. Loops once per
+/// set bit in `mask`, isolating the lowest with `m & m.wrapping_neg()`, so the
+/// cost is popcount(mask) rather than 64. The masks this is called with
+/// (ALL_TWO_INTERCEPTS, ALL_THREE_INTERCEPTS) hold 2..12 bits.
+///
+/// x86_64 builds are unaffected: this function is not compiled there.
+#[cfg(not(target_arch = "x86_64"))]
+#[inline(always)]
+pub unsafe fn compress_pext(mask: u64, val: u64) -> u16 {
+    let mut res: u64 = 0;
+    let mut bit: u32 = 0;
+    let mut m = mask;
+    while m != 0 {
+        let low = m & m.wrapping_neg();
+        if val & low != 0 {
+            res |= 1u64 << bit;
+
+        }
+        bit += 1;
+        m ^= low;
+
+    }
