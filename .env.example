# Local development needs no configuration — SQLite is created automatically
# at .data/gyges.db on first run.
#
# Copy to .env.local and edit only if you want something other than the
# defaults.

# Where the local SQLite database lives.
# GYGES_DB_PATH=./.data/gyges.db

# --- for production (not used locally) -------------------------------------
# The Postgres connection string, once the app moves off SQLite.
# DATABASE_URL=postgres://user:password@host/dbname

# The engine service, once move validation and bot play are wired up.
# See docs/ARCHITECTURE.md.
# GYGES_ENGINE_URL=http://localhost:9000
